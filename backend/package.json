{
  "name": "@explorer/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc --noEmit && node build.mjs",
    "start": "node dist/server.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "worker": "tsx --env-file-if-exists=.env src/worker.ts"
  },
  "dependencies": {
    "@worldcoin/idkit-core": "^4.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "mongoose": "^8.19.0",
    "pino": "^9.14.0",
    "viem": "^2.38.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.20.5",
    "@types/supertest": "^6.0.3",
    "esbuild": "^0.28.2",
    "mongodb-memory-server": "^10.2.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2",
    "vitest": "^5.1.0"
  }
}
