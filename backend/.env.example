# PRIVATE SERVER SETTINGS. Run npm run setup, then fill backend/.env.
# Do not create .env.dev: it is not loaded. Root .env/.env.local are not loaded.
# Never commit this file with real values. Restart the backend after edits.

# 1. LOCAL DEFAULTS: keep these unchanged for npm run dev.
NODE_ENV=development
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173

# 2. ACCOUNTS + ASSESSMENTS: required before you can register or save quizzes.
# Atlas > Connect > Drivers: copy the connection URI, with your database name.
# Use a database user/password, not your Atlas login. URL-encode password symbols.
# Allow your backend IP in Atlas Network Access. Do not paste the URI into chat.
MONGODB_URI=
# npm run setup generates these three when creating backend/.env.
# If you manually copy this example, generate three separate random secrets.
# Each must be at least 32 characters. Keep them private and backed up.
SESSION_SECRET=
# Keep these stable. Rotation needs a migration to preserve identity/reward IDs.
IDENTITY_SECRET=
REWARD_ID_SECRET=

# 3. WORLD ID (not a bot ID): needed for the one-human Master Challenge attempt.
# From your World Developer Portal registration. See docs/WORLD_ID_SETUP.md.
WORLD_ID_APP_ID=
# World ID 4 relying-party ID and its PRIVATE signing key are also required.
WORLD_ID_RP_ID=
# Replace with the exact registered action; do not casually rotate it later.
WORLD_ID_ACTION=
WORLD_ID_SIGNING_KEY=
# staging is for simulator testing only; it cannot earn rewards.
WORLD_ID_ENVIRONMENT=production
# orb-legacy accepts Orb v3 proofs using IDKit 4; proof-of-human requires v4.
# Choose one BEFORE binding users. Changing it later requires a migration.
WORLD_ID_CREDENTIAL_MODE=orb-legacy
# The server derives the official verifier URL from WORLD_ID_RP_ID.
# WORLD_ID_VERIFICATION_ENDPOINT is not used by this implementation.

# 4. SEPOLIA REWARDS: fill after deploying contracts. Not needed to read lessons.
# Sepolia chain ID is 11155111. Use an RPC endpoint from your provider.
SEPOLIA_RPC_URL=
# Deploy.s.sol creates BOTH distributor and token; read distributor.token().
REWARD_TOKEN_ADDRESS=
REWARD_DISTRIBUTOR_ADDRESS=
# Dedicated Sepolia-only account; never reuse an account with valuable assets.
# Must have test ETH and the deployed distributor's DISTRIBUTOR_ROLE.
# The learner never supplies this key. It belongs to the server operator.
REWARD_SIGNER_PROVIDER=local-testnet
REWARD_SIGNER_PRIVATE_KEY=
# Public administrator address; required by npm run deploy:contracts.
REWARD_ADMIN_ADDRESS=
# Leave false until chain, addresses, signer permission, and funding are verified.
REWARD_WORKER_ENABLED=false

# 5. HOSTING: leave these local defaults until Netlify/Render are configured.
# Direct cross-domain HTTPS: NODE_ENV=production, COOKIE_SAME_SITE=none,
# TRUST_PROXY=true on Render, FRONTEND_ORIGIN=your exact frontend origin.
COOKIE_SAME_SITE=lax
# Render ingress: enable only behind the documented trusted reverse proxy.
TRUST_PROXY=false

# DEPLOYMENT-ONLY (not read by the API): provide these to the Foundry shell.
# See docs/REWARDS.md for keystore deployment and explorer verification.
# REWARD_ADMIN_ADDRESS=  (administrator's PUBLIC address)
# REWARD_SIGNER_ADDRESS= (operational signer's PUBLIC address)
# ETHERSCAN_API_KEY=     (private explorer verification credential, if needed)
